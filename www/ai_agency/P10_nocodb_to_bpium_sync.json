{
  "name": "P10_nocodb_to_bpium_sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "d61165ac-6617-4784-93aa-283a391f3a01",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1008, 112]
    },
    {
      "parameters": {
        "authentication": "nocoDbApiToken",
        "operation": "getAll",
        "projectId": "={{ $env.NOCODB_PROJECT_ID }}",
        "table": "={{ $env.NOCODB_TABLE_LEADS }}",
        "limit": {},
        "options": {
          "where": "(synced,is,false)"
        }
      },
      "id": "971f3899-d979-4a50-94e3-c32c62e56801",
      "name": "NocoDB GetLeads",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 2,
      "position": [-800, 112],
      "credentials": {
        "nocoDbApiToken": {
          "id": "vNjvd0eQ6v5rgcD4",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c574e5b8-3e6c-4bfb-8d10-9826dfddd6fa",
              "name": "token",
              "value": "=Basic {{( $env.BPIUM_AUTHORIZATION ).base64Encode()}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c574e5b8-3e6c-4bfb-8d10-9826dfddd6f1",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-528, 112]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BP_API_URL }}/api/v1/catalogs/{{ $env.BP_CATALOG_ID }}/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"values\": {\n    \"2\": \"{{ $('NocoDB GetLeads').item.json.name }}\",\n    \"3\": \"{{ $('NocoDB GetLeads').item.json.phone }}\",\n    \"4\": \"{{ $('NocoDB GetLeads').item.json.email }}\",\n    \"5\": \"{{ $('NocoDB GetLeads').item.json.source }}\"\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000
        }
      },
      "id": "edf16068-9671-4e91-9986-56f670fa5c01",
      "name": "HTTP_Bpium_Create",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-192, 112]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "9e90503e-73d8-4ee7-b58a-2f3f4be1b7f1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ]
        }
      },
      "id": "9e90503e-73d8-4ee7-b58a-2f3f4be1b7f2",
      "name": "IF (statusCode = 2xx)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [0, 112]
    },
    {
      "parameters": {
        "authentication": "nocoDbApiToken",
        "operation": "update",
        "projectId": "={{ $env.NOCODB_PROJECT_ID }}",
        "table": "={{ $env.NOCODB_TABLE_LEADS }}",
        "id": "={{ $('NocoDB GetLeads').item.json.Id }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "synced",
              "fieldValue": "true"
            },
            {
              "fieldName": "bpium_id",
              "fieldValue": "={{ $('HTTP_Bpium_Create').item.json.body.id }}"
            }
          ]
        }
      },
      "id": "cd9f307b-a500-4077-95f6-5e939b86ffc1",
      "name": "NocoDB_UpdateLead (success)",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 2,
      "position": [208, 0],
      "credentials": {
        "nocoDbApiToken": {
          "id": "vNjvd0eQ6v5rgcD4",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=Не удалось синхронизировать лид {{ $('NocoDB GetLeads').item.json.name }} (ID: {{ $('NocoDB GetLeads').item.json.Id }}): HTTP status {{ $('HTTP_Bpium_Create').item.json.statusCode }}",
        "additionalFields": {}
      },
      "id": "09e4a91a-f359-4373-a99d-47f347c79b01",
      "name": "Telegram Send Message (error)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [208, 208],
      "credentials": {
        "telegramApi": {
          "id": "cunXlAL4wWgxX6sm",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "NocoDB GetLeads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "NocoDB GetLeads": {
      "main": [
        [
          {
            "node": "Edit Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Edit Fields": {
      "main": [
        [
          {
            "node": "HTTP_Bpium_Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP_Bpium_Create": {
      "main": [
        [
          {
            "node": "IF (statusCode = 2xx)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF (statusCode = 2xx)": {
      "main": [
        [
          {
            "node": "NocoDB_UpdateLead (success)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram Send Message (error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
